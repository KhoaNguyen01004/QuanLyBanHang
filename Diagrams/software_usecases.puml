@startuml
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rect

' Khai báo các actors theo thứ tự để chúng tự sắp xếp thành một cột thẳng hàng
actor "Khách hàng" as Customer
actor "Người bán" as Merchant
actor "Monitor" as MonitorActor

rectangle "Ứng Dụng Bán Hàng" {
  ' Khai báo các package theo thứ tự để chúng tự sắp xếp thành một hàng ngang thẳng hàng
  package "Khách hàng" {
    usecase "Đăng ký tài khoản\n(UC-CUS-001)" as UC_CUS_001
    usecase "Đăng nhập\n(UC-CUS-002)" as UC_CUS_002
    usecase "Đăng xuất\n(UC-CUS-003)" as UC_CUS_003
    usecase "Xem & tìm sản phẩm\n(UC-CUS-004)" as UC_CUS_004
    usecase "Quản lý giỏ hàng\n(UC-CUS-005)" as UC_CUS_005
    usecase "Thanh toán\n(UC-CUS-006)" as UC_CUS_006
    usecase "In/Lưu hóa đơn\n(UC-CUS-007)" as UC_CUS_007
    usecase "Xem lịch sử mua hàng\n(UC-CUS-008)" as UC_CUS_008
  }

  package "Người bán" {
    usecase "Đăng nhập người bán\n(UC-MER-001)" as UC_MER_001
    usecase "Đăng xuất người bán\n(UC-MER-002)" as UC_MER_002
    usecase "Quản lý sản phẩm\n(UC-MER-003)" as UC_MER_003
    usecase "Cập nhật tồn kho\n(UC-MER-004)" as UC_MER_004
    usecase "Xem đơn hàng\n(UC-MER-005)" as UC_MER_005
    usecase "Cập nhật sản phẩm hàng loạt\n(UC-MER-006)" as UC_MER_006
    usecase "Xem log & báo cáo\n(UC-MER-007)" as UC_MER_007
  }

  package "Monitor" {
    usecase "Giám sát giao dịch\n(UC-MON-001)" as UC_MON_001
    usecase "Nhận cảnh báo bất thường\n(UC-MON-002)" as UC_MON_002
    usecase "Xuất báo cáo vận hành\n(UC-MON-003)" as UC_MON_003
  }
}

' Liên kết Actors và Use Cases
Customer --> UC_CUS_001
Customer --> UC_CUS_002
Customer --> UC_CUS_003
Customer --> UC_CUS_004
Customer --> UC_CUS_005
Customer --> UC_CUS_006
Customer --> UC_CUS_007
Customer --> UC_CUS_008

Merchant --> UC_MER_001
Merchant --> UC_MER_002
Merchant --> UC_MER_003
Merchant --> UC_MER_004
Merchant --> UC_MER_005
Merchant --> UC_MER_006
Merchant --> UC_MER_007

MonitorActor --> UC_MON_001
MonitorActor --> UC_MON_002
MonitorActor --> UC_MON_003

@enduml