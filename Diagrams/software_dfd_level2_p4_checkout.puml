@startuml DFD_Level2_P4_Checkout
hide stereotype
left to right direction

actor "Khách hàng" as Customer

rectangle "P4.1\nValidate Cart Snapshot" as P41
rectangle "P4.2\nReserve & Price" as P42
rectangle "P4.3\nCreate Order" as P43
rectangle "P4.4\nFinalize Payment & Stock" as P44

database "D2\nItems" as D2
database "D3\nOrders" as D3
database "D4\nOrder Items" as D4
database "D5\nCarts" as D5
database "D6\nCart Items" as D6

Customer --> P41 : DF-005 \n(Payload checkout)
P41 --> D5 : Snapshot giỏ khóa
P41 --> D6 : Cart items đã khóa
P41 --> P42 : Giỏ hợp lệ + thông tin khách
P42 --> D2 : Danh sách item cần kiểm tồn cuối
P42 --> P43 : Dòng hàng đủ tồn + giá cuối
P43 --> D3 : Bản ghi đơn mới
P43 --> D4 : Bản ghi order item mới
P43 --> P44 : Thông tin đơn + tổng tiền
P44 --> D2 : Danh sách item cần giảm tồn
P44 --> Customer : DF-104 \n(Hóa đơn/biên nhận)
@enduml
