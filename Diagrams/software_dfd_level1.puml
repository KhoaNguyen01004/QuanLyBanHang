@startuml DFD_Level_1
hide stereotype
left to right direction
' Legend: P# = Process, D# = Data Store

actor "Khách hàng" as Customer
actor "Người bán" as Merchant
actor "Nền tảng giám sát" as Monitor

package "Ứng dụng Bán Hàng" as System {
  rectangle "P1\nĐăng ký / Xác thực" as P1
  rectangle "P2\nDuyệt & Tìm SP" as P2
  rectangle "P3\nQuản lý Giỏ" as P3
  rectangle "P4\nThanh toán & Hóa đơn" as P4
  rectangle "P5\nQuản lý Sản phẩm" as P5
  rectangle "P6\nCập nhật Tồn kho" as P6
  rectangle "P7\nQuản lý Đơn hàng (Read)" as P7
  rectangle "P8\nLog & Giám sát" as P8
}

' Data Stores
database "D1\nUsers" as D1
database "D2\nItems" as D2
database "D3\nOrders" as D3
database "D4\nOrder Items" as D4
database "D5\nCarts" as D5
database "D6\nCart Items" as D6

' External interactions
Customer --> P1 : DF-001 / DF-002 / DF-014 \n(Thông tin đăng ký/đăng nhập/token)
Customer --> P2 : DF-003 \n(Bộ lọc sản phẩm)
Customer --> P3 : DF-004 \n(Yêu cầu cập nhật giỏ)
Customer --> P4 : DF-005 \n(Payload checkout)
Customer --> P7 : DF-006 \n(Tham số truy vấn lịch sử)
Merchant --> P1 : DF-007 / DF-015 \n(Payload đăng nhập/đăng xuất)
Merchant --> P5 : DF-008 / DF-016 \n(Payload CRUD/batch sản phẩm)
Merchant --> P6 : DF-009 \n(Danh sách điều chỉnh tồn)
Merchant --> P7 : DF-010 \n(Bộ lọc đơn bán)
Merchant --> P8 : DF-011 \n(Tham số log/metric realtime)
Monitor --> P8 : DF-013 / DF-017 / DF-018 \n(Ping health, yêu cầu báo cáo, ack cảnh báo)

' Process-to-process
P1 --> P3 : Thông tin phiên
P1 --> P4 : Thông tin phiên
P1 --> P5 : Quyền quản lý SP
P1 --> P6 : Quyền tồn kho
P4 --> P7 : ID đơn mới
P6 --> P2 : Sự kiện tồn (item_id, stock mới)
P5 --> P2 : Sự kiện danh mục (metadata)

' Process ↔ Data Store
P1 --> D1 : Hồ sơ người dùng
P2 --> D2 : Danh mục SP + tồn
P3 --> D5 : Bản ghi giỏ
P3 --> D6 : Cart items
P3 --> D2 : Thông tin tồn cần kiểm tra
P4 --> D5 : Snapshot giỏ
P4 --> D6 : Cart items cho checkout
P4 --> D3 : Bản ghi đơn
P4 --> D4 : Order items
P4 --> D2 : Danh sách item cần giảm tồn
P5 --> D2 : Dữ liệu sản phẩm
P6 --> D2 : Batch điều chỉnh tồn
P7 --> D3 : Tiêu chí truy vấn đơn
P7 --> D4 : Tiêu chí truy vấn order items

' Process responses
P1 --> Customer : DF-101 \n(Token + trạng thái phiên)
P2 --> Customer : DF-102 \n(Danh sách sản phẩm)
P3 --> Customer : DF-103 \n(Ảnh chụp giỏ)
P4 --> Customer : DF-104 \n(Hóa đơn)
P7 --> Customer : DF-105 \n(Lịch sử đơn)
P1 --> Merchant : DF-106 \n(Token + quyền)
P5 --> Merchant : DF-107 / DF-113 \n(Kết quả CRUD/batch)
P6 --> Merchant : DF-108 \n(Trạng thái tồn mới)
P7 --> Merchant : DF-109 \n(Danh sách đơn)
P8 --> Merchant : DF-110 \n(Log/metric realtime)
P8 --> Monitor : DF-112 / DF-114 / DF-115 / DF-116 \n(Health snapshot, metric realtime, cảnh báo, báo cáo)

@enduml
